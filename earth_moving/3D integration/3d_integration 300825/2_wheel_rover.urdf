<robot name="test_robot">

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.32 0.17 0.05"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.07"/>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.32 0.17 0.05"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.045"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.003"/>
    </inertial>
  </link>

  <!-- Front Wheel -->
  <link name="front_wheel">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.0"/>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00002" iyz="0.0" izz="0.0003"/>
    </inertial>
  </link>

  <!-- Fixed Joint for Front Wheel -->
  <joint name="base_to_front_wheel" type="fixed">
    <parent link="base_link"/>
    <child link="front_wheel"/>
    <origin xyz="0.12 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- Left Wheel (Moved to the back) -->
  <link name="lwheel">
    <visual>
      <geometry>
        <cylinder length="0.03" radius="0.07"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.03" radius="0.07"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.000037" ixy="0.0" ixz="0.0" iyy="0.000037" iyz="0.0" izz="0.00049"/>
    </inertial>
  </link>

  <!-- Rotational Joint for Left Wheel -->
  <joint name="base_to_lwheel" type="continuous">
    <parent link="base_link"/>
    <child link="lwheel"/>
    <origin xyz="-0.12 0.1 0.07" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/> <!-- Rotate around Z-axis -->
  </joint>

  <!-- Right Wheel (Moved to the back) -->
  <link name="rwheel">
    <visual>
      <geometry>
        <cylinder length="0.03" radius="0.07"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.03" radius="0.07"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.000037" ixy="0.0" ixz="0.0" iyy="0.000037" iyz="0.0" izz="0.00049"/>
    </inertial>
  </link>

  <!-- Rotational Joint for Right Wheel -->
  <joint name="base_to_rwheel" type="continuous">
    <parent link="base_link"/>
    <child link="rwheel"/>
    <origin xyz="-0.12 -0.1 0.07" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/> <!-- Rotate around Z-axis -->
  </joint>


   <!-- Front Wheel Attachment -->
  <link name="shovel">
    <visual>
      <geometry>
        <box size="0.01 0.22 0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.01 0.22 0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="base_to_fattach" type="fixed">
    <parent link="base_link"/>
    <child link="shovel"/>
    <origin xyz="0.17 0 0.042" rpy="0 0 0"/>
  </joint>
  

</robot>
