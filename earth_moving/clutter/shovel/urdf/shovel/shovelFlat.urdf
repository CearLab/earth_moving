<?xml version="1.0"?>
<robot name="shovel">

  <!-- Materials -->  
  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0" /></material>
  <material name="light_grey"><color rgba="0.4 0.4 0.4 1.0" /></material>
  <material name="yellow"><color rgba="0.8 0.8 0.0 1.0" /></material>
  <material name="black"><color rgba="0.15 0.15 0.15 1.0" /></material>
  <material name="blue"><color rgba="0 0 .8 1"/></material>
  <material name="red"><color rgba="0.8 0 0 1"/></material>
  

  <!-- base_link -->
  <!-- Fixed reference frame for the cartesian robot -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>        
        <!-- 1 cm radius sphere -->
        <sphere radius="1e-2"/>
      </geometry>      
      <material name="blue" />
    </visual>
    <collision>
      <geometry>        
        <!-- 1 cm radius sphere -->
        <sphere radius="1e-2"/>
      </geometry>
    </collision>
    <inertial>
      <!-- set mass to very small to keep it nearly fixed -->
      <mass value="1e-3"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!-- from base to L1: prismatic joint (X motion) -->
  <joint name="base_L1_joint" type="prismatic">
    <axis xyz="1 0 0"/> 
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="L1_link" />        
    <limit lower="-10" upper="10" effort="1e2" velocity="0.005"/>
    <safety_controller k_position="10" k_velocity="10" soft_lower_limit="-9.5" soft_upper_limit="9.5"/>
    <dynamics damping="0.0" friction="0.1"/>
  </joint>

  <!-- L1_link -->
  <link name="L1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- 10x5x5 cm box -->
        <box size="5e-2 1e-2 1e-2"/>
      </geometry>
      <material name="yellow" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="5e-2 1e-2 1e-2"/>        
      </geometry>
    </collision>
    <inertial>      
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- 20 grams - 0.02 kg -->
      <mass value="20e-3"/> 
      <!-- inertia (anisotropic): m*l^2 [kg x m^2]-->   
      <inertia ixx="5e-5" ixy="0.0" ixz="0.0" iyy="2e-5" iyz="0.0" izz="5e-5"/>
      </inertial>
  </link>

  <!-- from L1 to L2: prismatic joint (Y motion) -->
  <joint name="L1_L2_joint" type="prismatic">
    <axis xyz="0 1 0"/> 
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="L1_link"/>
    <child link="L2_link" />        
    <limit lower="-10" upper="10" effort="1e2" velocity="0.005"/>
    <safety_controller k_position="10" k_velocity="10" soft_lower_limit="-9.5" soft_upper_limit="9.5"/>
    <dynamics damping="0.0" friction="0.1"/>
  </joint>

  <!-- L2_link -->
  <link name="L2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>        
        <cylinder radius="1e-2" length="4e-2"/>
      </geometry>
      <material name="light_grey" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="1e-2" length="4e-2"/>
      </geometry>
    </collision>
    <inertial>      
      <origin xyz="0 0 0" rpy="0 0 0"/>      
      <mass value="10e-3"/>       
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
      </inertial>
  </link>

  <!-- from L2 to EE: revolute joint (Z rotation for orientation) -->
  <joint name="L2_EE_joint" type="revolute">
    <!-- rotation along z-axis -->
    <axis xyz="0 0 1"/> 
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="L2_link"/>
    <child link="EE_link" />        
    <limit lower="-3.14159" upper="3.14159" effort="1e2" velocity="0.005"/>
    <safety_controller k_position="10" k_velocity="10" soft_lower_limit="-3.14" soft_upper_limit="3.14"/>
    <dynamics damping="0.0" friction="0.1"/>
  </joint>

  <!-- EE_link (end effector) -->
  <link name="EE_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>        
        <!-- 10x20x10 cm box -->
        <box size="1e-2 1e-1 5e-2"/>
      </geometry>   
      <material name="red" />   
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/> 
      <geometry>
        <box size="1e-2 1e-1 5e-2"/>   
      </geometry>     
    </collision>
    <inertial>      
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- 20 grams - 0.02 kg-->
      <mass value="20e-3"/> 
      <!-- inertia (anisotropic): m*l^2 [kg x m^2]-->
      <inertia ixx="5e-5" ixy="0.0" ixz="0.0" iyy="2e-4" iyz="0.0" izz="5e-5"/>
      </inertial>
  </link>
  
</robot>
